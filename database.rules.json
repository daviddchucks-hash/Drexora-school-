{
  "rules": {

    // ══════════════════════════════════════════════════════════════
    // STUDENTS
    // ══════════════════════════════════════════════════════════════
    "students": {

      // Admins can read & write the entire students subtree
      ".read":  "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",

      "$uid": {

        // PROFILE
        // Students: read & write their own profile (self-registration + profile updates)
        // Admins:   already covered by the parent rule above
        "profile": {
          ".read":  "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
          ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())"
        },

        // RESULTS
        // Students: read-only for their own results
        // Admins:   full read & write (upload, edit, delete results)
        // Covers: results/$session/$term  and  results/$session/$term/subjects/$subject
        "results": {
          ".read":  "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
          ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
        }
      }
    },

    // ══════════════════════════════════════════════════════════════
    // ADMINS
    // ══════════════════════════════════════════════════════════════
    "admins": {
      // Any authenticated user may check whether a UID is an admin
      // (required by auth-guard.js and login.js redirect checks)
      ".read":  "auth != null",

      // Only an existing admin can promote or demote another admin
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    // ══════════════════════════════════════════════════════════════
    // ANNOUNCEMENTS
    // ══════════════════════════════════════════════════════════════
    "announcements": {
      // All logged-in users (students + admins) can read announcements
      ".read":  "auth != null",

      // Only admins can create, edit, or delete announcements
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    // ══════════════════════════════════════════════════════════════
    // CONTACT MESSAGES  (public contact form on landing page)
    // ══════════════════════════════════════════════════════════════
    "contact_messages": {
      // Only admins can read submitted contact messages
      ".read":  "auth != null && root.child('admins').child(auth.uid).exists()",

      // Anyone (including unauthenticated visitors) can submit the
      // contact form — no login required on the landing page
      ".write": true,

      // Validate each message has the required fields and sane lengths
      "$messageId": {
        ".validate": "newData.hasChildren(['name','email','message','timestamp'])
                      && newData.child('name').isString()
                      && newData.child('name').val().length <= 120
                      && newData.child('email').isString()
                      && newData.child('email').val().length <= 254
                      && newData.child('message').isString()
                      && newData.child('message').val().length <= 2000
                      && newData.child('timestamp').isNumber()"
      }
    },

    // ══════════════════════════════════════════════════════════════
    // SETTINGS  (portal password gate and other admin config)
    // ══════════════════════════════════════════════════════════════
    "settings": {
      // Only admins can read or change portal settings
      ".read":  "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    }

  }
}
